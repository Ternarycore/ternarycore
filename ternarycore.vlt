lint_off  -rule PINMISSING   -file "*ternary_gemm.v"
lint_off  -rule UNUSEDPARAM  -file "*ternary_gemm.v"
lint_off  -rule UNUSEDSIGNAL -file "*ternary_gemm.v"
lint_off  -rule UNUSEDSIGNAL -file "*ternary_scale.v"