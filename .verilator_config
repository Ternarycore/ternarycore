// Verilator lint configuration for TernaryCore.
//
// Suppression rationale:
//   BLKSEQ        — blocking assignments for intermediate combinational
//                   values (weighted, weighted_ext, next_acc) within a
//                   sequential always block. Intentional pattern: computed
//                   immediately before use, not registered. Equivalent to
//                   a separate `always_comb` block.
//   UNUSEDPARAM   — DOT_ID is preserved for ILA debug identification
//                   even when $display debug statements are removed.
//   UNUSEDSIGNAL  — debug_* signals (ILA capture taps) are marked
//                   (* mark_debug, keep, dont_touch *) for FPGA probing
//                   and are intentionally unused in simulation.
//   MODMISSING    — ternary_gemm instantiates ternary_dot; lint targets
//                   pass -I flags for multi-file modules, so this won't
//                   fire in normal use.

lint_off  -rule BLKSEQ       -file "rtl/ternary_dot.v"
lint_off  -rule UNUSEDPARAM  -file "rtl/ternary_dot.v"
lint_off  -rule UNUSEDSIGNAL -file "rtl/ternary_dot.v"
lint_off  -rule PINMISSING   -file "rtl/ternary_gemm.v"