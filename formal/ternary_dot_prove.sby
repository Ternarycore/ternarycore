[options]
mode bmc
depth 14

[engines]
smtbmc

[script]
read -formal ternary_weight.v
read -formal ternary_dot.v
read -formal ternary_dot_formal.v
setattr -unset keep *
setattr -unset dont_touch *
setattr -unset mark_debug *
prep -top ternary_dot_formal

[files]
../rtl/ternary_weight.v
../rtl/ternary_dot.v
ternary_dot_formal.v
