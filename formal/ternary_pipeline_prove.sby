# Bounded-model-checking proof for the full inference pipeline.
#
# Note: mode is bmc, not prove. The RTL's dot product uses a down-counter
# state machine; k-induction (mode prove) can reach unreachable over-approximated
# states where the sliding-window reference is unconstrained garbage while the
# RTL accumulator is still zero, producing spurious induction counterexamples
# (observed in the ternary_dot prove). Bounded BMC over depth 12 reaches reset
# + one full vector end-to-end (feed -> quant -> gemm -> scale -> drain) plus
# the drain cycles, which is the behavior the asserts cover, and is non-vacuous
# because ternary_pipeline_formal.v instantiates the real RTL pipeline.
[options]
mode bmc
depth 12

[engines]
smtbmc

[script]
read -formal activation_quant.v
read -formal ternary_dot.v
read -formal ternary_weight.v
read -formal ternary_gemm.v
read -formal ternary_scale.v
read -formal ternary_pipeline.v
read -formal ternary_pipeline_formal.v
setattr -unset keep *
setattr -unset dont_touch *
setattr -unset mark_debug *
prep -top ternary_pipeline_formal
flatten
opt

[files]
../rtl/activation_quant.v
../rtl/ternary_dot.v
../rtl/ternary_weight.v
../rtl/ternary_gemm.v
../rtl/ternary_scale.v
../rtl/ternary_pipeline.v
ternary_pipeline_formal.v
