[options]
mode bmc
depth 10
timeout 300000

[engines]
smtbmc

[script]
read -formal activation_quant.v
read -formal ternary_dot.v
read -formal ternary_gemm.v
read -formal ternary_scale.v
read -formal ternary_pipeline.v
read -formal ternary_pipeline_stress_formal.v
setattr -unset keep *
setattr -unset dont_touch *
setattr -unset mark_debug *
prep -top ternary_pipeline_stress_formal
flatten
opt

[files]
../rtl/activation_quant.v
../rtl/ternary_dot.v
../rtl/ternary_defines.vh
../rtl/ternary_gemm.v
../rtl/ternary_scale.v
../rtl/ternary_pipeline.v
ternary_pipeline_stress_formal.v