[options]
mode cover
depth 12

[engines]
smtbmc

[script]
read -formal ternary_gemm.v
read -formal ternary_dot.v
read -formal ternary_gemm_formal.v
setattr -unset keep *
setattr -unset dont_touch *
setattr -unset mark_debug *
prep -top ternary_gemm_formal

[files]
../rtl/ternary_defines.vh
../rtl/ternary_gemm.v
../rtl/ternary_dot.v
ternary_gemm_formal.v
